<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{460EB04C-81A3-44F2-8DEB-7022D8C332FB}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="DBTool.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="bbs2.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="DBTool">
        <MSBuild Projects="DBTool.dproj"/>
    </Target>
    <Target Name="DBTool:Clean">
        <MSBuild Projects="DBTool.dproj" Targets="Clean"/>
    </Target>
    <Target Name="DBTool:Make">
        <MSBuild Projects="DBTool.dproj" Targets="Make"/>
    </Target>
    <Target Name="bbs2">
        <MSBuild Projects="bbs2.dproj"/>
    </Target>
    <Target Name="bbs2:Clean">
        <MSBuild Projects="bbs2.dproj" Targets="Clean"/>
    </Target>
    <Target Name="bbs2:Make">
        <MSBuild Projects="bbs2.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="DBTool;bbs2"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="DBTool:Clean;bbs2:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="DBTool:Make;bbs2:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
